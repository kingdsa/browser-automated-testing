PORT=8787
LLM_BASE_URL=https://your-gateway.com/v1
LLM_API_KEY=sk-your-key
LLM_MODEL=gpt-4o-mini
# 需求分析和思维导图采用完成驱动续写，默认单阶段最多运行 60 分钟
REQUIREMENTS_AI_MAX_RUN_MS=3600000
REQUIREMENTS_AI_NO_PROGRESS_LIMIT=3
REQUIREMENTS_AI_RETRY_BASE_DELAY_MS=1000
MAX_AGENT_STEPS=0
# true/false; omit to auto-detect (Linux without DISPLAY => true)
PLAYWRIGHT_HEADLESS=

# --- TypeSafe Jev (optional typed-decision fast path) ---
# 前端设置页也可手动填写 API Key；这里配置后前端可留空。
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
